# SECRETS: put IDs in config/ids.ts. Never commit .env.
DISCORD_BOT_TOKEN=
ERLC_SERVER_API_KEY=
DATABASE_URL=postgresql://lasrp:CHANGE_THIS_LOCAL_PASSWORD@localhost:5432/lasrp
# local = persistent embedded database for local use; postgres = external PostgreSQL for hosting.
DATABASE_MODE=postgres
# Optional local database directory (never run two instances against the same path).
LOCAL_DATABASE_PATH=data/local-postgres
DISCORD_OAUTH_CLIENT_SECRET=
APP_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_BASE_URL=http://localhost:3000
PORT=3000
DASHBOARD_TOKEN=
FILE_STORAGE_SECRET=
BOT_ENABLED=true
DEMO_MODE=false
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Local development can use off; production enforces required. Never expose clamd publicly.
EVIDENCE_SCAN_MODE=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Windows portable PostgreSQL (installed locally by the recovery workflow).
# Use DATABASE_MODE=portable with the runtime under data/portable-postgres/pgsql.
PORTABLE_POSTGRES_HOME=data/portable-postgres/pgsql
PORTABLE_DATABASE_PATH=data/postgres-durable
PORTABLE_DATABASE_PORT=54328
PORTABLE_DATABASE_PASSWORD=
