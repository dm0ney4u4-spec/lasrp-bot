# Backend-only configuration: merge these into the existing ROOT .env as needed.
# Never paste keys into apps/site or any VITE_ variable.
ERLC_SERVER_API_KEY=
# Optional approved public game link. Do not infer it from the private API response.
PUBLIC_ERLC_JOIN_CODE=
PUBLIC_ERLC_JOIN_URL=
# Exact origin of a separate public website, when cross-origin status access is needed.
PUBLIC_SITE_ORIGIN=

# Existing shared OAuth backend (register /auth/callback in the Discord developer portal).
WEB_BASE_URL=http://localhost:3000
# Use this canonical hostname even when opening the preview at 127.0.0.1.
WEBSITE_BASE_URL=http://localhost:5173
# Production: both origins must be the same HTTPS public origin with /api and /auth proxied.
