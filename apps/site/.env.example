# Public URLs only. Every VITE_ value is included in the browser bundle.
# Keep empty until a real hosted CAD origin is available. Never paste tokens here.
VITE_CAD_URL=
# Optional public status backend origin. Leave empty for same-origin /api or the local Vite proxy.
# Never put the ER:LC key here. A separate production origin must be HTTPS.
VITE_PUBLIC_API_ORIGIN=
