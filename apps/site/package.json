{
  "name": "@lasrp/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/security-headers.mjs && node scripts/audit-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "media:prepare": "node scripts/prepare-media.mjs && node scripts/optimize-media.mjs",
    "media:optimize": "node scripts/optimize-media.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
